# Redis Configuration
# For local development, you can use a local Redis instance or leave this blank
# to disable caching in development mode
REDIS_URL=redis://localhost:6379

# In production (Vercel/Netlify), use a Redis service like:
# - Upstash Redis: redis://:password@endpoint.upstash.io:port
# - Redis Labs: redis://username:password@endpoint.redislabs.com:port
# - AWS ElastiCache: redis://endpoint.cache.amazonaws.com:6379

# OpenRouter API Key — used for all LLM text generation (td-agent, blog chat)
# Required at runtime. Get one at https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-...

# OpenAI API Key — used for embeddings only (text-embedding-3-large).
# Required only when building the vector DB (`npm run build:vectordb`).
# Without it, the build step skips gracefully and blog chat retrieval is disabled.
# OPENAI_API_KEY=sk-...

# Admin token for protected endpoints (e.g. /api/cache/clear)
# ADMIN_TOKEN=your_secret_token
