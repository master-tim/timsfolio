---
import type { CollectionEntry } from "astro:content";
import TdShell from "@/layouts/TdShell.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

type Props = CollectionEntry<"blog">["data"];

const {
  title = "",
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
} = Astro.props;

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentSlug =
  typeof Astro.params.slug === "string" ? Astro.params.slug : "";
const relatedPosts = posts.filter((p) => p.id !== currentSlug).slice(0, 5);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{webp,jpeg,jpg,png,gif}",
);
const heroImgModule = heroImage && images[heroImage] ? images[heroImage] : null;
---

<TdShell
  title={title}
  description={description}
  active="writing"
  maxWidth="1080px"
  image={heroImage}
>
  <article class="post">
    <header class="post-header">
      <p class="td-eyebrow">/writing</p>
      <h1 class="td-display post-h1">{title}</h1>
      {description && (
        <p class="post-lede" set:html={description} />
      )}
      <div class="post-meta">
        <span class="post-meta-date">
          <FormattedDate date={pubDate} />
        </span>
        {updatedDate && (
          <span class="post-meta-updated">
            · updated <FormattedDate date={updatedDate} />
          </span>
        )}
        {tags && tags.length > 0 && (
          <span class="post-meta-tags">
            {tags.map((t) => (
              <span class="td-pill">{t}</span>
            ))}
          </span>
        )}
      </div>
    </header>

    {heroImgModule && (
      <figure class="post-hero">
        <Image src={heroImgModule()} alt={title} loading="eager" />
      </figure>
    )}

    <div class="post-body">
      <div class="td-prose">
        <slot />
      </div>

      <aside class="post-aside" aria-label="Related writing">
        <div class="aside-block">
          <p class="td-eyebrow">author</p>
          <p class="aside-name">Temirlan Dzhoroev</p>
          <p class="aside-sub">AI Engineer · Seoul, KR</p>
          <div class="aside-links">
            <a href="mailto:dzhoroev1@gmail.com">→ email</a>
            <a href="https://github.com/master-tim" target="_blank" rel="noopener">→ github</a>
            <a href="https://linkedin.com/in/dzhoroev7" target="_blank" rel="noopener">→ linkedin</a>
            <a href="/">→ talk to td-agent</a>
          </div>
        </div>

        {relatedPosts.length > 0 && (
          <div class="aside-block">
            <p class="td-eyebrow">related</p>
            <ul class="aside-related">
              {relatedPosts.map((p) => (
                <li>
                  <a href={`/blog/${p.id}/`}>→ {p.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>

    <div class="post-nav">
      <a class="post-nav-back" href="/blog">◂ all writing</a>
      <a class="post-nav-home" href="/">▸ back to td-agent</a>
    </div>
  </article>
</TdShell>

<style>
  .post-header {
    margin-bottom: 28px;
    max-width: 780px;
  }
  .post-h1 {
    font-size: clamp(30px, 4.5vw, 46px);
    margin: 0 0 14px;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .post-lede {
    color: var(--a-muted);
    font-size: 15.5px;
    line-height: 1.7;
    margin: 0 0 18px;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    color: var(--a-muted);
    letter-spacing: 0.02em;
  }
  .post-meta-date,
  .post-meta-updated {
    color: var(--a-muted);
  }
  .post-meta-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .post-hero {
    margin: 28px 0 36px;
    padding: 0;
    border: 1px solid var(--a-line);
    border-radius: 3px;
    overflow: hidden;
    background: var(--a-surf);
  }
  .post-hero :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 460px;
    object-fit: cover;
  }

  .post-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 56px;
    align-items: start;
  }

  /* Aside */
  .post-aside {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    font-size: 12.5px;
  }
  .aside-block {
    border-top: 1px solid var(--a-line);
    padding-top: 16px;
  }
  .aside-name {
    color: var(--a-ink);
    margin: 2px 0 2px;
    font-size: 13px;
    letter-spacing: -0.005em;
  }
  .aside-sub {
    color: var(--a-muted);
    font-size: 12px;
    margin: 0 0 12px;
  }
  .aside-links,
  .aside-related {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .aside-links a,
  .aside-related a {
    color: var(--a-muted);
    text-decoration: none;
    font-size: 12.5px;
    padding: 3px 0;
    transition: color 0.15s;
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .aside-links a:hover,
  .aside-related a:hover {
    color: var(--a-accent);
  }
  .aside-related li {
    line-height: 1.45;
  }

  /* Nav */
  .post-nav {
    border-top: 1px solid var(--a-line);
    margin-top: 56px;
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 12.5px;
  }
  .post-nav a {
    color: var(--a-muted);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.15s;
  }
  .post-nav a:hover {
    color: var(--a-accent);
  }

  @media (max-width: 900px) {
    .post-body {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .post-aside {
      position: static;
    }
  }
</style>
