---
import TdShell from "@/layouts/TdShell.astro";

const description =
  "AI Engineer — production LLM/RAG systems, 3D game engines, HCI research";

const experience = [
  {
    role: "AI Engineer",
    co: "Redbrick",
    loc: "Seoul",
    date: "Jul 2024 — now",
    bullets: [
      {
        strong: "End-to-end AI game creation system",
        rest:
          " (intent parsing, asset generation, scene composition, logic synthesis) — centerpiece of a $1.2M Korean government R&D grant.",
      },
      {
        strong: "Production RAG pipelines",
        rest:
          " over 15K+ documents in ChromaDB with hybrid retrieval, query rewriting and bge-reranker — relevance +35%, hallucination 18% → 4%, latency 3.2s → 0.8s.",
      },
      {
        strong: "Multi-step agentic workflows",
        rest:
          " (ReACT, CoT) orchestrating LLM calls across asset generation, physics config, and script authoring — up to 8 dependent tool calls per request.",
      },
      {
        strong: "Semantic caching layer",
        rest:
          " (embedding similarity) — ~40% fewer LLM calls, ~$2K/month saved.",
      },
      {
        strong: "Eval & safety",
        rest:
          ": prompt regression harnesses, output guardrails, structured validation, policy-compliant generation.",
      },
    ],
  },
  {
    role: "3D Frontend Engineer",
    co: "Redbrick",
    loc: "Seoul",
    date: "Jul 2023 — Jul 2024",
    bullets: [
      {
        strong: "Browser 3D game engine",
        rest:
          " (Three.js, WebGL, TypeScript) powering 54M+ game plays and 10M+ user sign-ups.",
      },
      {
        strong: "Codebase modernization",
        rest:
          " of 50K+ lines from Webpack → Vite, upgraded rendering pipeline, swapped physics engine — build time −60%, bundle −35%, hot-reload 8s → 1s.",
      },
      {
        strong: "Modular packages",
        rest:
          " across 3 teams; integration tests for scene graph and asset loading.",
      },
      {
        strong: "Onboarding redesign",
        rest:
          " via session replay + interviews — D7 activation +25%, D30 retention +15%.",
      },
    ],
  },
  {
    role: "Embedded Systems & HCI Researcher",
    co: "DECS Lab, UNIST",
    loc: "Ulsan",
    date: "Feb 2021 — Feb 2023",
    bullets: [
      {
        strong: "IoT firmware in C",
        rest:
          " for ARM Cortex-M MCUs, real-time smart sensor arrays (50+ devices, sub-ms latency).",
      },
      {
        strong: "10 peer-reviewed papers + 6 patents",
        rest:
          ". First author at IEEE RO-MAN 2023, ICROS 2022, HCI Korea 2022.",
      },
    ],
  },
];

const education = [
  {
    degree: "M.S. in Design (Human-Computer Interaction)",
    school: "UNIST, South Korea",
    date: "Feb 2023",
    thesis:
      "Human perception of social-robot face and color expression using computational emotion models.",
    tags: [
      "HCI & HRI",
      "Lotte Scholarship",
      "GPA 4.0 / 4.3",
      "6 papers",
      "4 journals",
      "6 patents",
    ],
  },
  {
    degree: "B.S. in Computer Science & Industrial Design",
    school: "UNIST, South Korea",
    date: "2021",
    thesis: null,
    tags: ["Dual degree", "Global UNISTAR Silver Scholarship"],
  },
];

const skills = [
  {
    label: "Languages",
    items: ["TypeScript", "Python", "JavaScript", "C / C++"],
  },
  {
    label: "AI / LLM",
    items: [
      "LangChain",
      "LlamaIndex",
      "Vercel AI SDK",
      "ChromaDB",
      "OpenAI",
      "Claude",
      "Embeddings",
      "RAG",
      "Agents",
      "Evals",
    ],
  },
  {
    label: "Frontend & 3D",
    items: ["React", "Next.js", "Astro", "Three.js", "WebGL", "Vite", "Node.js"],
  },
  {
    label: "Infrastructure",
    items: ["Docker", "AWS", "Redis", "CI/CD", "Git"],
  },
  {
    label: "Research",
    items: ["HCI", "HRI", "Computer Vision", "Embedded C", "ARM Cortex-M"],
  },
];

const certs = [
  "Advanced RAG with Vector Databases · IBM · 2025",
  "Foundation — LangChain (Python) · LangChain · 2025",
  "Gen AI Agents · Google Cloud · 2025",
  "Build RAG Applications · IBM · 2025",
  "Three.js Journey — Completion · 2023",
  "Advanced React · Meta · 2023",
];
---

<TdShell title="About — Temirlan Dzhoroev" description={description} active="about">
  <section class="about-hero">
    <p class="td-eyebrow">about</p>
    <h1 class="td-display about-h1">
      I build production LLM/RAG systems and browser 3D engines<span class="td-accent">.</span>
    </h1>
    <p class="about-lede">
      AI Engineer at <span class="td-accent">Redbrick</span> in Seoul. I ship
      end-to-end AI pipelines from prototype to production — agentic workflows,
      RAG over large document corpora, semantic caches, 3D game engines. Grounded
      in an HCI research foundation: 10 peer-reviewed papers, 6 patents.
    </p>
    <div class="about-cta">
      <a class="about-btn primary" href="/cv" target="_blank" rel="noopener noreferrer"
        >▸ read cv.pdf</a
      >
      <a class="about-btn" href="mailto:dzhoroev1@gmail.com">→ email</a>
      <a class="about-btn" href="/">→ talk to td-agent</a>
    </div>
  </section>

  <section class="td-section">
    <h2>Experience</h2>
    <p class="td-section-sub">
      2021 — now · AI / 3D / research, always in production.
    </p>
    <div class="td-rule"></div>
    {
      experience.map((e) => (
        <div class="exp">
          <div class="exp-head">
            <div>
              <strong class="exp-role">{e.role}</strong>
              <span class="exp-co">· {e.co}</span>
            </div>
            <div class="exp-meta">
              {e.date} · {e.loc}
            </div>
          </div>
          <ul class="exp-bullets">
            {e.bullets.map((b) => (
              <li>
                <strong>{b.strong}</strong>
                {b.rest}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="td-section">
    <h2>Education</h2>
    <p class="td-section-sub">Design × CS, HCI/HRI focus.</p>
    <div class="td-rule"></div>
    {
      education.map((e) => (
        <div class="edu td-card">
          <div class="edu-head">
            <strong>{e.degree}</strong>
            <span class="edu-date">{e.date}</span>
          </div>
          <div class="edu-school">{e.school}</div>
          {e.thesis && <div class="edu-thesis">Thesis: {e.thesis}</div>}
          <div class="edu-tags">
            {e.tags.map((t) => (
              <span class="td-pill">{t}</span>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <section class="td-section">
    <h2>Stack</h2>
    <p class="td-section-sub">What I reach for, in order of depth.</p>
    <div class="td-rule"></div>
    <div class="skills">
      {
        skills.map((s) => (
          <div class="skills-row">
            <span class="skills-label">{s.label}</span>
            <span class="skills-items">
              {s.items.map((it) => (
                <span class="td-pill">{it}</span>
              ))}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="td-section">
    <h2>Certifications</h2>
    <p class="td-section-sub">Recent focus: RAG, agents, vector DBs.</p>
    <div class="td-rule"></div>
    <ul class="certs">
      {certs.map((c) => <li>→ {c}</li>)}
    </ul>
  </section>

  <section class="td-section">
    <h2>Why</h2>
    <div class="td-rule"></div>
    <p class="why-line">
      I'm not the person who'll build your fourteenth demo. I'm the person who
      makes demo #1 a product — eval harnesses, cost dials, guardrails, the boring
      parts that decide whether an AI system ships or stalls.
    </p>
    <p class="why-line muted">
      Want the fast version? Talk to <a href="/" class="td-accent">td-agent</a>.
    </p>
  </section>
</TdShell>

<style>
  .about-hero {
    margin-bottom: 72px;
  }
  .about-h1 {
    font-size: clamp(32px, 5vw, 54px);
    margin: 0 0 20px;
    max-width: 22ch;
  }
  .about-lede {
    color: var(--a-muted);
    font-size: 15px;
    line-height: 1.7;
    max-width: 60ch;
    margin: 0 0 24px;
  }
  .about-cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .about-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--a-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--a-muted);
    border: 1px solid var(--a-line);
    padding: 9px 14px;
    border-radius: 2px;
    transition:
      color 0.15s,
      border-color 0.15s,
      background 0.15s;
  }
  .about-btn:hover {
    color: var(--a-accent);
    border-color: var(--a-accent);
  }
  .about-btn.primary {
    color: var(--a-accent);
    border-color: color-mix(in srgb, var(--a-accent) 55%, transparent);
    background: color-mix(in srgb, var(--a-accent) 10%, transparent);
  }
  .about-btn.primary:hover {
    border-color: var(--a-accent);
    background: color-mix(in srgb, var(--a-accent) 18%, transparent);
  }

  /* Experience */
  .exp {
    border-top: 1px solid var(--a-line);
    padding: 22px 0;
  }
  .exp:first-of-type {
    border-top: none;
    padding-top: 0;
  }
  .exp-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .exp-role {
    font-size: 15px;
    color: var(--a-ink);
    letter-spacing: -0.005em;
  }
  .exp-co {
    color: var(--a-muted);
    font-weight: 400;
    margin-left: 4px;
  }
  .exp-meta {
    font-size: 12px;
    color: var(--a-muted);
    letter-spacing: 0.02em;
  }
  .exp-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .exp-bullets li {
    padding: 5px 0 5px 18px;
    position: relative;
    color: var(--a-muted);
    font-size: 13.5px;
    line-height: 1.65;
  }
  .exp-bullets li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--a-faint);
  }
  .exp-bullets strong {
    color: var(--a-ink);
    font-weight: 600;
  }

  /* Education */
  .edu {
    margin-top: 12px;
  }
  .edu:first-of-type {
    margin-top: 0;
  }
  .edu-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .edu-head strong {
    font-size: 14.5px;
    color: var(--a-ink);
    letter-spacing: -0.005em;
  }
  .edu-date {
    font-size: 11.5px;
    color: var(--a-muted);
  }
  .edu-school {
    color: var(--a-muted);
    font-size: 12.5px;
    margin-top: 4px;
  }
  .edu-thesis {
    color: var(--a-muted);
    font-size: 12.5px;
    margin-top: 10px;
    font-style: italic;
  }
  .edu-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  /* Skills */
  .skills {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .skills-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 16px;
    align-items: start;
  }
  .skills-label {
    color: var(--a-muted);
    font-size: 12px;
    letter-spacing: 0.04em;
    padding-top: 4px;
  }
  .skills-items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Certs */
  .certs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .certs li {
    color: var(--a-muted);
    font-size: 13px;
    padding: 4px 0;
  }

  /* Why */
  .why-line {
    color: var(--a-ink);
    font-size: 15px;
    line-height: 1.7;
    max-width: 60ch;
  }
  .why-line.muted {
    color: var(--a-muted);
    font-size: 13px;
    margin-top: 14px;
  }
  .why-line a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .skills-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .skills-label {
      padding-top: 0;
    }
  }
</style>
