---
import TdShell from "@/layouts/TdShell.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
---

<TdShell
  title="Writing — Temirlan Dzhoroev"
  description="Essays, project notes, and publications by Temirlan Dzhoroev — AI Engineer."
  active="writing"
>
  <section class="writing-hero">
    <p class="td-eyebrow">writing</p>
    <h1 class="td-display writing-h1">
      Notes from shipping AI systems<span class="td-accent">.</span>
    </h1>
    <p class="writing-lede">
      Project write-ups, engineering notes, and peer-reviewed publications.
      Dry, measured, and mostly about the boring parts that make things ship.
    </p>
  </section>

  <section class="td-section">
    <div class="td-rule"></div>
    <ul class="post-list" role="list">
      {
        posts.map((post) => (
          <li class="post-row">
            <a href={`/blog/${post.id}/`} class="post-link">
              <span class="post-date">{fmt(post.data.pubDate)}</span>
              <span class="post-title">{post.data.title}</span>
              <span class="post-arrow" aria-hidden="true">▸</span>
            </a>
            <p class="post-desc" set:html={post.data.description} />
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.slice(0, 5).map((t: string) => (
                  <span class="td-pill">{t}</span>
                ))}
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</TdShell>

<style>
  .writing-hero {
    margin-bottom: 56px;
  }
  .writing-h1 {
    font-size: clamp(30px, 4.5vw, 46px);
    margin: 0 0 16px;
    max-width: 22ch;
  }
  .writing-lede {
    color: var(--a-muted);
    font-size: 14.5px;
    line-height: 1.7;
    max-width: 58ch;
    margin: 0;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .post-row {
    padding: 22px 0;
    border-bottom: 1px solid var(--a-line);
  }
  .post-row:first-child {
    padding-top: 4px;
  }
  .post-link {
    display: grid;
    grid-template-columns: 130px 1fr 24px;
    gap: 16px;
    align-items: baseline;
    color: var(--a-ink);
    text-decoration: none;
    padding: 4px 0;
    transition: color 0.15s;
  }
  .post-link:hover {
    color: var(--a-accent);
  }
  .post-link:hover .post-arrow {
    color: var(--a-accent);
    transform: translateX(4px);
  }
  .post-date {
    color: var(--a-muted);
    font-size: 12px;
    letter-spacing: 0.02em;
  }
  .post-title {
    font-family: var(--a-display);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .post-arrow {
    color: var(--a-faint);
    justify-self: end;
    font-size: 14px;
    transition: transform 0.15s, color 0.15s;
  }
  .post-desc {
    color: var(--a-muted);
    font-size: 13px;
    line-height: 1.65;
    margin: 10px 0 0 146px;
    max-width: 60ch;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 0 146px;
  }

  @media (max-width: 640px) {
    .post-link {
      grid-template-columns: 1fr 20px;
      gap: 4px;
    }
    .post-date {
      grid-column: 1 / span 2;
      font-size: 11px;
    }
    .post-title {
      font-size: 17px;
    }
    .post-desc,
    .post-tags {
      margin-left: 0;
    }
  }
</style>
