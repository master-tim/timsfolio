  }
  .td-stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .td-stack-tag {
    font-size: 11px;
    color: var(--a-ink);
    border: 1px solid var(--a-line);
    padding: 3px 9px;
    border-radius: 2px;
  }

  /* JSON */
  .td-json-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 14px;
    padding: 6px 16px;
  }
  .td-json-row + .td-json-row {
    border-top: 1px solid var(--a-line);
  }
  .td-json-k {
    color: var(--a-faint);
    font-size: 11.5px;
  }
  .td-json-v {
    color: var(--a-ink);
    font-size: 12.5px;
    word-break: break-word;
  }

  /* Input bar */
  .td-input-bar {
    padding: 16px 0 24px;
    border-top: 1px solid var(--a-line);
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--a-bg);
  }
  .td-input-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--a-line);
    background: var(--a-surf);
    padding: 12px 16px;
    border-radius: 2px;
    transition: border-color 0.2s;
  }
  .td-input-wrap.active {
    border-color: var(--a-accent);
  }
  .td-input-wrap .td-prompt {
    color: var(--a-accent);
  }
  .td-input-wrap input {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    font-family: var(--a-mono);
    font-size: 14px;
    color: var(--a-ink);
    min-width: 0;
  }
  .td-input-wrap input::placeholder {
    color: var(--a-faint);
  }
  .td-input-wrap button {
    font-family: var(--a-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--a-muted);
    background: transparent;
    border: 1px solid var(--a-line);
    padding: 6px 14px;
    border-radius: 2px;
    cursor: default;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background 0.15s,
      color 0.15s,
      border-color 0.15s;
  }
  .td-input-wrap button:not([disabled]) {
    color: var(--a-bg);
    background: var(--a-accent);
    border-color: var(--a-accent);
    cursor: pointer;
  }
  .td-input-foot {
    font-size: 10.5px;
    color: var(--a-faint);
    display: flex;
    justify-content: space-between;
    letter-spacing: 0.04em;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Caret blink */
  @keyframes td-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  .td-caret {
    animation: td-blink 1s steps(1) infinite;
  }

  /* Responsive */
  @media (max-width: 800px) {
    .td-agent {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      height: auto;
      min-height: 100vh;
      min-height: 100dvh;
      overflow: visible;
    }
    .td-sidebar {
      height: auto;
      max-height: none;
      overflow-y: visible;
      border-right: none;
      border-bottom: 1px solid var(--a-line);
      padding: 20px 20px 24px;
    }
    .td-main {
      height: auto;
      min-height: calc(100vh - 60px);
      min-height: calc(100dvh - 60px);
      padding: 0 20px;
      overflow: visible;
    }
    .td-log {
      overflow: visible;
      max-height: none;
    }
    .td-input-bar {
      position: sticky;
      bottom: 0;
      z-index: 50;
      margin: 0 -20px;
      padding-left: 20px;
      padding-right: 20px;
    }
    .td-work-head,
    .td-work-row {
      grid-template-columns: 58px 1fr 90px;
    }
    .td-work-head span:nth-child(3),
    .td-work-row .o {
      display: none;
    }
    .td-pub-row {
      grid-template-columns: 48px 1fr;
      row-gap: 4px;
    }
    .td-pub-row .v {
      grid-column: 2;
    }
    .td-pub-row .t {
      grid-column: 1 / span 2;
    }
    .td-pub-row .r {
      grid-column: 1 / span 2;
      text-align: left;
    }
    .td-stack-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>

<script is:inline define:vars={{ TD_DATA }}>
  (function () {
    "use strict";

    // Shared across init/cleanup — survives across view transitions because
    // this script-level closure is only created once by the browser.
    let ctx = null;

    function cleanup() {
      if (!ctx) return;
      clearInterval(ctx.uptimeTimer);
      ctx = null;
    }

    function init() {
      // Tear down any previous instance (navigating back to "/")
      cleanup();

      const root = document.querySelector(".td-agent");
      if (!root) return;
      // Guard against double-init on the same DOM instance
      if (root.dataset.tdReady === "1") return;
      root.dataset.tdReady = "1";

      const D = TD_DATA;

    const $ = (sel) => root.querySelector(sel);
    const $$ = (sel) => Array.from(root.querySelectorAll(sel));

    const logEl = $("#td-log");
    const formEl = $("#td-form");
    const inputEl = $("#td-input");
    const sendEl = $("#td-send");
    const inputWrap = $("#td-input-wrap");
    const cmdsEl = $("#td-cmds");
    const uptimeEl = $("#td-uptime");

    // Locked config (what the Tweaks panel used to control)
    const CONFIG = Object.freeze({
      tone: "playful, dry, confident",
      showThoughts: true,
    });

    // ───── Session history (sessionStorage) ─────
    // We record every rendered row as a serializable event and replay the
    // event log on navigation return, so the user's chat is preserved within
    // the tab session. Cleared on `clear`/`reset` and when the tab closes.
    const HISTORY_KEY = "td-agent-history-v1";
    let history = [];
    function loadHistory() {
      try {
        const raw = sessionStorage.getItem(HISTORY_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        return Array.isArray(parsed) && parsed.length ? parsed : null;
      } catch {
        return null;
      }
    }
    function saveHistory() {
      try {
        sessionStorage.setItem(HISTORY_KEY, JSON.stringify(history));
      } catch {}
    }
    function clearHistoryStore() {
      history = [];
      try {
        sessionStorage.removeItem(HISTORY_KEY);
      } catch {}
    }

    // ───── Commands ─────
    const suggestions = [
      { t: "tour", hot: true },
      { t: "show work", hot: true },
      { t: "tell me about RAG", hot: true },
      { t: "why hire you", hot: true },
      { t: "weakness" },
      { t: "experience" },
      { t: "publications" },
      { t: "stack" },
      { t: "contact" },
    ];
    suggestions.forEach((s) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "td-cmd";
      if (s.hot) b.dataset.hot = "1";
      b.innerHTML = `<span class="td-arrow">→</span><span>${escHtml(s.t)}</span>`;
      b.addEventListener("click", () => {
        if (busy) return;
        send(s.t);
      });
      cmdsEl.appendChild(b);
    });

    // ───── Uptime ─────
    let startedAt = Date.now();
    const uptimeTimer = setInterval(() => {
      const sec = Math.floor((Date.now() - startedAt) / 1000);
      const m = Math.floor(sec / 60);
      const ss = sec % 60;
      uptimeEl.textContent = `${String(m).padStart(2, "0")}:${String(ss).padStart(2, "0")}`;
    }, 1000);

    // ───── Log rendering ─────
    let busy = false;

    function escHtml(s) {
      return String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function scrollLog() {
      // Desktop: the log element has overflow-y: auto, scroll it to bottom.
      logEl.scrollTop = logEl.scrollHeight;
      // Mobile: the page itself scrolls (log has overflow: visible).
      // Also scroll the window to the bottom so the latest row is visible.
      const doc = document.scrollingElement || document.documentElement;
      if (doc.scrollHeight - doc.scrollTop - doc.clientHeight > 4) {
        window.scrollTo({ top: doc.scrollHeight, behavior: "auto" });
      }
    }

    function pushRow(node) {
      logEl.appendChild(node);
      // Two rAFs: first for layout, second for the scroll to land after paint.
      requestAnimationFrame(() => {
        scrollLog();
        requestAnimationFrame(scrollLog);
      });
    }

    function rowSystem(text) {
      const d = document.createElement("div");
      d.className = "td-row-system";
      d.textContent = `※ ${text}`;
      return d;
    }
    function rowUser(text) {
      const d = document.createElement("div");
      d.className = "td-row-user";
      d.innerHTML = `<span class="td-prompt">td &gt;</span><span>${escHtml(text)}</span>`;
      return d;
    }
    function rowThought(text) {
      if (!CONFIG.showThoughts) return null;
      const d = document.createElement("div");
      d.className = "td-row-thought";
      d.textContent = `· ${text}`;
      return d;
    }
    function rowAssistant(text) {
      const d = document.createElement("div");
      d.className = "td-row-assistant";
      d.innerHTML = `<span class="td-text"></span><span class="td-caret">▍</span>`;
      const textSpan = d.querySelector(".td-text");
      const caret = d.querySelector(".td-caret");
      // Type-out
      let i = 0;
      const step = text.length > 200 ? 4 : 1;
      const speed = text.length > 200 ? 8 : 12;
      const timer = setInterval(() => {
        i += step;
        if (i >= text.length) {
          textSpan.textContent = text;
          caret.remove();
          clearInterval(timer);
        } else {
          textSpan.textContent = text.slice(0, i);
        }
        scrollLog();
      }, speed);
      return d;
    }
    function rowThinking() {
      const d = document.createElement("div");
      d.className = "td-row-thinking";
      d.innerHTML = `▍ thinking<span class="td-th-dots"></span>`;
      const dotsEl = d.querySelector(".td-th-dots");
      let n = 0;
      const t = setInterval(() => {
        n = (n + 1) % 4;
        dotsEl.textContent = ".".repeat(n);
      }, 220);
      d.__stop = () => clearInterval(t);
      return d;
    }

    // Tool rows
    function rowTool(name, status, renderer) {
      const wrap = document.createElement("div");
      const head = document.createElement("div");
      head.className = "td-tool-head";
      head.innerHTML = `<span>⚙</span><span>${escHtml(name)}</span>`;
      if (status) {
        const st = document.createElement("span");
        st.className = "td-tool-status" + (status === "ok" ? "" : " err");
        st.textContent = status.toUpperCase();
        head.appendChild(st);
      }
      wrap.appendChild(head);
      const box = document.createElement("div");
      box.className = "td-tool-box";
      renderer(box);
      wrap.appendChild(box);
      return wrap;
    }

    function renderWork(box) {
      const head = document.createElement("div");
      head.className = "td-work-head";
      head.innerHTML = `<span>year</span><span>project</span><span>what</span><span>kind</span>`;
      box.appendChild(head);
      D.work.forEach((w) => {
        const r = document.createElement("div");
        r.className = "td-work-row";
        r.innerHTML = `
          <span class="y">${escHtml(w.year)}</span>
          <span class="t">${escHtml(w.title)}</span>
          <span class="o">${escHtml(w.oneliner)}</span>
          <span class="k">▸ ${escHtml(w.kind)}</span>
        `;
        r.addEventListener("click", () => {
          if (busy) return;
          send(`tell me about ${w.id}`);
        });
        box.appendChild(r);
      });
    }

    function renderProject(box, id) {
      const w = D.work.find((x) => x.id === id);
      if (!w) return;
      const head = document.createElement("div");
      head.className = "td-proj-head";
      head.innerHTML = `<strong class="td-proj-title">${escHtml(w.title)}</strong><span class="td-proj-meta">${escHtml(w.year)} · ${escHtml(w.kind)}</span>`;
      box.appendChild(head);

      const body = document.createElement("div");
      body.className = "td-proj-body";

      const one = document.createElement("div");
      one.className = "td-proj-one";
      one.textContent = w.oneliner;
      body.appendChild(one);

      const ctx = document.createElement("div");
      ctx.className = "td-proj-ctx";
      ctx.textContent = w.ctx;
      body.appendChild(ctx);

      const tags = document.createElement("div");
      tags.className = "td-tags";
      w.stack.forEach((s) => {
        const tag = document.createElement("span");
        tag.className = "td-tag";
        tag.textContent = s;
        tags.appendChild(tag);
      });
      body.appendChild(tags);

      const metric = document.createElement("div");
      metric.className = "td-metric";
      metric.textContent = `▸ ${w.metric}`;
      body.appendChild(metric);

      if (w.decisions && w.decisions.length) {
        const dec = document.createElement("div");
        dec.className = "td-decisions";
        const lbl = document.createElement("div");
        lbl.className = "td-dec-label";
        lbl.textContent = "KEY DECISIONS";
        dec.appendChild(lbl);
        w.decisions.forEach((d, i) => {
          const row = document.createElement("div");
          row.className = "td-dec-row";
          row.innerHTML = `<span>${String(i + 1).padStart(2, "0")} →</span><span>${escHtml(d)}</span>`;
          dec.appendChild(row);
        });
        body.appendChild(dec);
      }

      box.appendChild(body);
    }

    function renderExp(box) {
      D.exp.forEach((e) => {
        const row = document.createElement("div");
        row.className = "td-exp-row";
        const head = document.createElement("div");
        head.className = "td-exp-head";
        head.innerHTML = `
          <span class="td-exp-role"><strong>${escHtml(e.role)}</strong> <span class="td-exp-co">· ${escHtml(e.co)}</span></span>
          <span class="td-exp-date">${escHtml(e.date)} · ${escHtml(e.loc)}</span>
        `;
        row.appendChild(head);
        e.bullets.forEach((b) => {
          const bb = document.createElement("div");
          bb.className = "td-exp-bullet";
          bb.innerHTML = `<span>—</span><span>${escHtml(b)}</span>`;
          row.appendChild(bb);
        });
        box.appendChild(row);
      });
    }

    function renderPubs(box) {
      D.pubs.forEach((p) => {
        const r = document.createElement("div");
        r.className = "td-pub-row";
        r.innerHTML = `
          <span class="y">${escHtml(p.year)}</span>
          <span class="v">${escHtml(p.venue)}</span>
          <span class="t">${escHtml(p.title)}</span>
          <span class="r">${escHtml(p.role)}</span>
        `;
        box.appendChild(r);
      });
    }

    function renderStack(box) {
      D.stack.forEach(([k, items]) => {
        const r = document.createElement("div");
        r.className = "td-stack-row";
        const lbl = document.createElement("span");
        lbl.className = "k";
        lbl.textContent = k;
        r.appendChild(lbl);
        const tags = document.createElement("span");
        tags.className = "td-stack-tags";
        items.forEach((it) => {
          const t = document.createElement("span");
          t.className = "td-stack-tag";
          t.textContent = it;
          tags.appendChild(t);
        });
        r.appendChild(tags);
        box.appendChild(r);
      });
    }

    function renderJSON(box, payload) {
      Object.entries(payload).forEach(([k, v]) => {
        const r = document.createElement("div");
        r.className = "td-json-row";
        r.innerHTML = `<span class="td-json-k">${escHtml(k)}</span><span class="td-json-v">${escHtml(String(v))}</span>`;
        box.appendChild(r);
      });
    }

    // Non-animated assistant row — used when replaying saved history.
    function rowAssistantStatic(text) {
      const d = document.createElement("div");
      d.className = "td-row-assistant";
      d.textContent = text;
      return d;
    }

    // ───── Event dispatcher ─────
    // Each log row the agent produces is represented as a small serializable
    // event. `pushEvent` appends to history + persists + renders. `renderEvent`
    // just renders (used for replay on navigation return).
    //
    // Event shapes:
    //   { type: "system",    text }
    //   { type: "user",      text }
    //   { type: "thought",   text }
    //   { type: "assistant", text }                         (animated when live, static on replay)
    //   { type: "tool",      name, status, kind, data? }
    //     kind ∈ "work" | "exp" | "pubs" | "stack" | "project" | "json"
    const TOOL_RENDER = {
      work:    (box)        => renderWork(box),
      exp:     (box)        => renderExp(box),
      pubs:    (box)        => renderPubs(box),
      stack:   (box)        => renderStack(box),
      project: (box, data)  => renderProject(box, data),
      json:    (box, data)  => renderJSON(box, data || {}),
    };

    function renderEvent(ev, opts) {
      const instant = !!(opts && opts.instant);
      let node = null;
      switch (ev.type) {
        case "system":
          node = rowSystem(ev.text);
          break;
        case "user":
          node = rowUser(ev.text);
          break;
        case "thought":
          if (!CONFIG.showThoughts) return;
          node = rowThought(ev.text);
          break;
        case "assistant":
          node = instant ? rowAssistantStatic(ev.text) : rowAssistant(ev.text);
          break;
        case "tool":
          node = rowTool(ev.name, ev.status, (box) => {
            const r = TOOL_RENDER[ev.kind];
            if (r) r(box, ev.data);
          });
          break;
      }
      if (node) pushRow(node);
    }

    function pushEvent(ev) {
      history.push(ev);
      saveHistory();
      renderEvent(ev);
    }

    // ───── Intents & handlers ─────
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

    const INTENTS = [
      { re: /^(tour|overview|start|begin|hi|hello|hey)\b/i, fn: "tour" },
      {
        re: /work|project|shipped|built|portfolio|ship/i,
        fn: "listWork",
        guard: (q) => !/rag|engine|cache|game|robot|fitt/i.test(q),
      },
      { re: /rag|retriev|halluc|15k|chroma/i, fn: "rag" },
      { re: /game|text.?to.?game|agent|pipeline/i, fn: "aiGames" },
      { re: /cache|cost|budget|save/i, fn: "cache" },
      { re: /engine|three|webgl|3d|redbrick/i, fn: "engine" },
      { re: /robot|ro.?man|hri|thesis/i, fn: "robot" },
      { re: /fitt|eye.?track|face.?track/i, fn: "fitts" },
      { re: /hire|why|pitch|strength|should i/i, fn: "pitch" },
      { re: /experience|resume|cv|career|where.*work/i, fn: "career" },
      { re: /paper|publication|research|academ|phd/i, fn: "pubs" },
      { re: /stack|tool|tech|language/i, fn: "stack" },
      { re: /contact|email|reach|available|open/i, fn: "contact" },
      { re: /skills|what.*(can|do) you (do|build)/i, fn: "skills" },
      { re: /where.*live|location|seoul|timezone|gmt/i, fn: "location" },
      { re: /weak|fail|worst|fuck.?up|mistake/i, fn: "weakness" },
      { re: /joke|fun|haha|lol/i, fn: "joke" },
      { re: /ping|status|alive/i, fn: "ping" },
      { re: /clear|reset/i, fn: "clear" },
      { re: /help|\?|commands/i, fn: "help" },
    ];

    function match(q) {
      for (const i of INTENTS) {
        if (i.re.test(q) && (!i.guard || i.guard(q))) return i.fn;
      }
      return null;
    }

    const handlers = {
      async tour() {
        pushEvent({ type: "thought", text: "rolling the 30-second version." });
        await sleep(350);
        pushEvent({
          type: "tool", name: "tour()", status: "ok", kind: "json",
          data: {
            now: "AI Engineer @ Redbrick · Seoul · open to senior IC",
            shipped:
              "$1.2M RAG/agent pipeline · 3.2s→0.8s · 18%→4% hallucination",
            before: "Modernized Redbrick 3D engine — 54M plays",
            earlier: "10 peer-reviewed papers, 6 patents (HRI + embedded)",
            next: "try: show work · why hire you · tell me about RAG",
          },
        });
      },

      async listWork() {
        pushEvent({ type: "thought", text: "listing 6 of 18 projects, newest first." });
        await sleep(300);
        pushEvent({ type: "tool", name: "list_work(limit=6)", status: "ok", kind: "work" });
      },

      async rag()     { await projectCard("rag-15k"); },
      async aiGames() { await projectCard("ai-games"); },
      async cache()   { await projectCard("semantic-cache"); },
      async engine()  { await projectCard("engine"); },
      async robot()   { await projectCard("robot-face"); },
      async fitts()   { await projectCard("fitts"); },

      async career() {
        pushEvent({ type: "tool", name: "timeline()", status: "ok", kind: "exp" });
      },

      async pubs() {
        pushEvent({ type: "tool", name: "publications(limit=6)", status: "ok", kind: "pubs" });
      },

      async stack() {
        pushEvent({ type: "tool", name: "stack()", status: "ok", kind: "stack" });
      },

      async skills() {
        await typeAssistant(
          `Roughly, in order of depth:

 · RAG systems — ingestion, hybrid retrieval, rerank, eval, guardrails
 · Agents — ReACT, tool-use orchestration, dependency graphs
 · 3D / WebGL — Three.js engines at production scale
 · Frontend — React, Next.js, Astro, Tailwind
 · Research — HRI, computer vision, embedded C (if you need it)

If you want depth on any of these, ask me.`,
        );
      },

      async pitch() {
        pushEvent({ type: "thought", text: "being honest, not a salesperson." });
        await sleep(450);
        await typeAssistant(
          `Three honest answers:

1. I've shipped LLM systems end-to-end, not just prompts. RAG, agents, caching, evals.
2. Research background means I read the paper before I open the IDE.
3. I care about the boring parts — eval harnesses, cost dials, guardrails.

Not the person who'll build your fourteenth demo. The person who makes demo #1 a product.`,
        );
      },

      async weakness() {
        pushEvent({ type: "thought", text: "these are real answers, not interview answers." });
        await sleep(350);
        await typeAssistant(
          `Three things I'm working on:

 · I over-index on measurement. Sometimes you just have to ship the thing and see.
 · I underestimate how long writing takes. I'm usually a day late on docs.
 · I'm not a distributed-systems native — I can reason about it, not architect it from scratch.

Counter-weight: none of these have cost anyone money. Yet.`,
        );
      },

      async contact() {
        pushEvent({
          type: "tool", name: "contact()", status: "ok", kind: "json",
          data: {
            email: D.email,
            github: "github.com/" + D.github,
            linkedin: "linkedin.com/in/" + D.linkedin,
            timezone: D.tz,
            reply_sla: "usually <24h",
          },
        });
      },

      async location() {
        pushEvent({
          type: "tool", name: "whereami()", status: "ok", kind: "json",
          data: {
            city: D.location,
            timezone: D.tz,
            remote: "yes · friendly to NA/EU teams",
            relocate: "open to discussion",
          },
        });
      },

      async ping() {
        const latency = (Math.random() * 40 + 12).toFixed(1);
        pushEvent({
          type: "tool", name: "ping()", status: "ok", kind: "json",
          data: {
            status: "alive",
            latency_ms: latency,
            model: "td-agent@0.4.2",
          },
        });
      },

      async joke() {
        const jokes = [
          'Two RAG engineers walk into a bar. Bartender asks "embedding?" They say "yes please, with re-rank."',
          "My favorite framework? Whichever one my on-call rotation is least familiar with.",
          "I told my LLM to be concise. It wrote me a haiku about why conciseness is subjective.",
        ];
        await typeAssistant(jokes[Math.floor(Math.random() * jokes.length)]);
      },

      async help() {
        pushEvent({
          type: "tool", name: "help()", status: "ok", kind: "json",
          data: {
            work: "show work · tell me about RAG · cache · engine · games",
            me: "tour · why hire you · weakness · skills · experience",
            meta: "contact · pubs · stack · ping · location",
            easter_egg: "ask me a joke",
          },
        });
      },

      async clear() {
        logEl.innerHTML = "";
        clearHistoryStore();
      },
    };

    async function projectCard(id) {
      const w = D.work.find((x) => x.id === id);
      if (!w) return;
      pushEvent({ type: "thought", text: `opening ${w.id}…` });
      await sleep(200);
      pushEvent({
        type: "tool",
        name: `open(project="${w.id}")`,
        status: "ok",
        kind: "project",
        data: id,
      });
    }

    function typeAssistant(text) {
      return new Promise((resolve) => {
        pushEvent({ type: "assistant", text });
        const total = text.length;
        const dur = total > 200 ? (total / 4) * 8 + 80 : total * 12 + 80;
        setTimeout(resolve, Math.min(dur, 4000));
      });
    }

    // ───── Fallback to Claude via /api/agent ─────
    async function claudeFallback(query) {
      pushEvent({ type: "thought", text: "no pattern match — routing to claude-haiku." });
      await sleep(200);
      try {
        const res = await fetch("/api/agent", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ query, tone: CONFIG.tone }),
        });
        if (!res.ok) throw new Error("agent http " + res.status);
        const data = await res.json();
        const text =
          (data && typeof data.text === "string" && data.text.trim()) ||
          `hmm, not sure how to route "${query}". try \`help\` or one of: tour · show work · why hire you · contact.`;
        await typeAssistant(text);
      } catch (err) {
        await typeAssistant(
          `hmm, not sure how to route "${query}". try \`help\` or one of: tour · show work · why hire you · contact.`,
        );
      }
    }

    // ───── Send / respond ─────
    async function send(q) {
      const query = (q == null ? inputEl.value : q).trim();
      if (!query || busy) return;
      inputEl.value = "";
      updateSendState();
      setBusy(true);

      pushEvent({ type: "user", text: query });
      await sleep(200);

      const fn = match(query);
      if (fn && handlers[fn]) {
        try {
          await handlers[fn]();
        } catch (err) {
          await typeAssistant(`error: ${err.message || "something broke"}`);
        }
      } else {
        await claudeFallback(query);
      }

      setBusy(false);
      setTimeout(() => inputEl.focus(), 20);
    }

    function setBusy(b) {
      busy = b;
      $$(".td-cmd").forEach((c) => (c.disabled = b));
      inputEl.disabled = b;
      updateSendState();
    }
    function updateSendState() {
      const has = inputEl.value.trim().length > 0;
      sendEl.disabled = !has || busy;
      inputWrap.classList.toggle("active", has);
    }
    inputEl.addEventListener("input", updateSendState);

    // ───── Submit ─────
    formEl.addEventListener("submit", (e) => {
      e.preventDefault();
      send();
    });

    // ───── Intro seed (or replay from sessionStorage) ─────
    async function seed() {
      // If the user navigated away and came back, restore the prior chat.
      const saved = loadHistory();
      if (saved) {
        history = saved;
        saved.forEach((ev) => renderEvent(ev, { instant: true }));
        // Land at the bottom after all rows paint.
        requestAnimationFrame(() => scrollLog());
        setTimeout(() => inputEl.focus(), 50);
        return;
      }

      // Fresh session — run the normal intro.
      pushEvent({
        type: "system",
        text: `td-agent v0.4.2 — session started · ${new Date().toISOString().slice(0, 10)}`,
      });
      pushEvent({
        type: "system",
        text: "type a question or click a suggestion. `help` for commands.",
      });
      await sleep(500);
      pushEvent({ type: "user", text: "whoami" });
      await sleep(200);
      pushEvent({
        type: "tool", name: "identity()", status: "ok", kind: "json",
        data: {
          name: D.name,
          role: D.role + " · Redbrick, Seoul",
          status: "● open to senior IC — AI / applied LLM",
          summary: D.tagline,
          metrics: `${D.metrics.plays} plays · ${D.metrics.grant} grant · ${D.metrics.papers} papers, ${D.metrics.patents} patents`,
        },
      });
      setTimeout(() => inputEl.focus(), 50);
    }
    seed();

    // Expose uptime timer for cleanup()
    ctx = { uptimeTimer };
    }

    // Astro ClientRouter hooks — fire on first load AND on every navigation.
    // Because this script runs once per document, the listeners we register
    // here persist across view transitions. `init` re-binds to the new DOM
    // after each swap; `cleanup` tears down the interval before the swap.
    document.addEventListener("astro:page-load", init);
    document.addEventListener("astro:before-swap", cleanup);
  })();
</script>
