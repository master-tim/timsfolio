---
// Agent-as-portfolio console.
// Sidebar + main chat log. Local intent matching renders tool-call cards
// (work table, project details, timeline, publications, stack).
// Free-form queries fall through to /api/agent (Claude via OpenRouter).

const TD_DATA = {
  name: "Temirlan Dzhoroev",
  handle: "td",
  role: "AI Engineer",
  location: "Seoul, KR",
  tz: "GMT+9",
  email: "dzhoroev1@gmail.com",
  github: "master-tim",
  linkedin: "dzhoroev7",

  tagline: "I build production LLM/RAG systems and browser 3D engines.",

  metrics: {
